  {
    "name": "feed.publish-feed",
    "description": "发表帖子",
    "risk": "write",
    "flags": [
      {
        "name": "guild-id",
        "type": "string",
        "pattern": "uint",
        "description": "腾讯频道 ID（普通用户模式必填；作者身份全局发帖时不传或传 0）"
      },
      {
        "name": "channel-id",
        "type": "string",
        "pattern": "uint",
        "description": "版块 ID（普通用户模式必填；作者身份全局发帖时不传或传 0）"
      },
      {
        "name": "title",
        "type": "string",
        "description": "帖子标题 (长贴必填, 有标题自动升级为长贴)"
      },
      {
        "name": "content",
        "type": "string",
        "description": "帖子内容 (普通文本模式必填; 与 --markdown-content 互斥)"
      },
      {
        "name": "markdown-content",
        "type": "string",
        "description": "Markdown 格式正文 (仅长贴支持, 需提供 --title; 与 --content 互斥; 支持 [(0,N)](@img) 图片占位符和 [video:N] 视频占位符)"
      },
      {
        "name": "content-file",
        "type": "string",
        "description": "从文件读取正文 (txt/md), 与 --content 互斥"
      },
      {
        "name": "feed-type",
        "type": "int",
        "default": 1,
        "enum": [
          "1",
          "2"
        ],
        "description": "帖子类型: 1=短贴 2=长贴"
      },
      {
        "name": "image",
        "type": "string_array",
        "description": "图片文件路径 (可多次指定, 短贴≤18张/长贴≤50张)"
      },
      {
        "name": "video",
        "type": "string_array",
        "description": "视频文件路径 (短贴最多 1 个, 长贴最多 5 个)"
      },
      {
        "name": "at-user",
        "type": "string_array",
        "description": "@用户追加到正文末尾 (格式: tinyid:昵称); 推荐改用 content 内联语法 @[昵称](tinyid); Markdown 模式无效"
      },
      {
        "name": "link",
        "type": "string_array",
        "description": "文字链接追加到正文末尾 (格式: url|显示文字); 推荐改用 content 内联语法 [显示文字](url)"
      },
      {
        "name": "topic-name",
        "type": "string_array",
        "description": "话题名追加到正文末尾 (可多次指定); 推荐改用 content 内联语法 #[话题名]()"
      }
    ]
  },
