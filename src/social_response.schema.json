{
  "type": "object",
  "properties": {
    "reply": {
      "type": "string"
    },
    "social": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "say",
            "silent"
          ]
        },
        "next_wake_ms": {
          "type": [
            "integer",
            "null"
          ]
        },
        "active_topic": {
          "type": "string"
        },
        "pending_thought": {
          "type": "string"
        },
        "clear_topic": {
          "type": "boolean"
        },
        "wait": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "timer",
                "condition",
                "indefinite"
              ]
            },
            "keywords": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 60
              },
              "maxItems": 12
            },
            "speakers": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 20
            },
            "match": {
              "type": "string",
              "enum": [
                "any",
                "all"
              ]
            }
          },
          "required": [
            "mode",
            "keywords",
            "speakers",
            "match"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "action",
        "next_wake_ms",
        "active_topic",
        "pending_thought",
        "clear_topic",
        "wait"
      ],
      "additionalProperties": false
    },
    "media": {
      "type": "object",
      "properties": {
        "send_id": {
          "type": "string"
        },
        "voice_id": {
          "type": "string"
        },
        "selection": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "fit": {
              "type": "string",
              "enum": [
                "contextual",
                "requested",
                "none"
              ]
            },
            "message_id": {
              "type": "string"
            },
            "catalog_evidence": {
              "type": "string"
            },
            "intent": {
              "type": "string"
            }
          },
          "required": [
            "fit",
            "message_id",
            "catalog_evidence",
            "intent"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "send_id",
        "voice_id",
        "selection"
      ],
      "additionalProperties": false
    },
    "expression": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "mood": {
          "type": "string",
          "enum": [
            "calm",
            "happy",
            "playful",
            "curious",
            "sleepy",
            "concerned",
            "annoyed"
          ]
        },
        "energy": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "continuity": {
          "type": "string",
          "maxLength": 120
        }
      },
      "required": [
        "mood",
        "energy",
        "continuity"
      ],
      "additionalProperties": false
    },
    "speech": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "text": {
          "type": "string",
          "maxLength": 120
        },
        "mood": {
          "type": "string",
          "enum": [
            "calm",
            "happy",
            "playful",
            "curious",
            "sleepy",
            "concerned",
            "annoyed"
          ]
        }
      },
      "required": [
        "text",
        "mood"
      ],
      "additionalProperties": false
    },
    "character_updates": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "object",
        "properties": {
          "operation": {
            "type": "string",
            "enum": [
              "upsert",
              "delete"
            ]
          },
          "id": {
            "type": "string",
            "maxLength": 80
          },
          "kind": {
            "type": "string",
            "enum": [
              "style",
              "interest",
              "rapport"
            ]
          },
          "text": {
            "type": "string",
            "maxLength": 160
          },
          "source_message_id": {
            "type": "string",
            "maxLength": 512
          },
          "source_excerpt": {
            "type": "string",
            "maxLength": 160
          }
        },
        "required": [
          "operation",
          "id",
          "kind",
          "text",
          "source_message_id",
          "source_excerpt"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "reply",
    "social",
    "media",
    "expression",
    "speech",
    "character_updates"
  ],
  "additionalProperties": false
}
