# Credentials stay in the local .env or your process environment. Never commit .env.
QQ_APP_ID=
QQ_APP_SECRET=
# Set a strong pairing phrase; SHA-256 is generated by npm run init.
QQ_PAIRING_CODE=
MODEL_API_KEY=
# Optional Codex CLI executable; only used when type=codex.
CODEX_CLI_PATH=

# Optional image decoder: absolute path to your Python venv with Pillow installed.
XIAOKE_PYTHON_PATH=
